<?xml version="1.0" encoding="UTF-8"?>
<!--
  The same atom, handed `[x] > x.length` instead. A string does have `length`,
  so the handler can do what it does with what it will be given. The pair with
  `reject-callback-argument-type` is the point: reading `args=` has to accept
  the callback that fits as surely as it refuses the one that does not.
-->
<program name="accept-callback-argument-type">
  <o name="main" loc="Φ.main" line="1">
    <o name="chomp" loc="Φ.main.chomp" line="2">
      <o base="∅" name="cant" args="Φ.string" loc="Φ.main.chomp.cant" line="3"/>
      <o name="λ" atom="Φ.bytes" loc="Φ.main.chomp.λ" line="2"/>
    </o>
    <o name="φ" base="ξ.chomp" loc="Φ.main.φ" line="5">
      <o as="α0" name="handler" loc="Φ.main.φ.α0" line="5">
        <o base="∅" name="x" loc="Φ.main.φ.α0.x" line="5"/>
        <o name="φ" base=".length" loc="Φ.main.φ.α0.φ" line="6" pos="4">
          <o base="ξ.x" loc="Φ.main.φ.α0.φ.ρ" line="6"/>
        </o>
      </o>
    </o>
  </o>
</program>
